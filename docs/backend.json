
{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuário",
      "description": "Dados de perfil e papel do usuário no sistema.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SECRETARY", "ADMIN", "UBS_MANAGER", "DRIVER"] },
        "unitId": { "type": "string", "description": "ID da UBS (apenas para UBS_MANAGER)" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "TransportRequest": {
      "title": "Solicitação de Transporte",
      "description": "Dados de um pedido de transporte sanitário.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "ubsId": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "destinationLocation": { "type": "string" },
        "urgencyLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "DENIED", "COMPLETED", "CANCELLED"] },
        "requestedTime": { "type": "string", "format": "date-time" },
        "patientAccessCode": { "type": "string", "description": "Código de 6 dígitos para acesso público do paciente." }
      }
    },
    "DriverReport": {
      "title": "Relatório de Campo do Motorista",
      "description": "Feedback enviado pelo motorista ao encerrar uma jornada.",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "vehicleId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["driverId", "driverName", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Coleção de usuários e seus papéis."
    },
    "/requests/{requestId}": {
      "schema": "TransportRequest",
      "description": "Solicitações de transporte realizadas pelas UBS."
    },
    "/reports/{reportId}": {
      "schema": "DriverReport",
      "description": "Feedbacks e relatórios enviados pelos condutores."
    }
  }
}
