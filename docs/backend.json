
{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuário",
      "description": "Dados de perfil e papel do usuário no sistema.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SECRETARY", "ADMIN", "UBS_MANAGER", "DRIVER"] },
        "unitId": { "type": "string", "description": "ID da UBS (apenas para UBS_MANAGER)" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Patient": {
      "title": "Paciente / Cidadão",
      "description": "Dados cadastrais do cidadão para transporte sanitário.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "medicalRecordNumber": { "type": "string", "description": "CNS ou Prontuário" },
        "comorbidities": { "type": "array", "items": { "type": "string" } },
        "needsCompanion": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "medicalRecordNumber"]
    },
    "TransportRequest": {
      "title": "Solicitação de Transporte",
      "description": "Dados de um pedido de transporte sanitário.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "ubsId": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "destinationLocation": { "type": "string" },
        "urgencyLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "DENIED", "COMPLETED", "CANCELLED"] },
        "requestedTime": { "type": "string", "format": "date-time" },
        "patientAccessCode": { "type": "string", "description": "Código de 6 dígitos para acesso público." },
        "driverId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "manifestId": { "type": "string" },
        "aiRecommendation": { "type": "string" }
      },
      "required": ["patientId", "pickupLocation", "destinationLocation", "status"]
    },
    "Vehicle": {
      "title": "Veículo da Frota",
      "description": "Viatura oficial do município.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Ambulância", "Van", "Sedan", "Acessível"] },
        "licensePlate": { "type": "string" },
        "capacity": { "type": "number" },
        "available": { "type": "boolean" },
        "status": { "type": "string", "enum": ["AVAILABLE", "MAINTENANCE", "IN_USE"] },
        "odometer": { "type": "number" },
        "fuelLevel": { "type": "number" },
        "lastMaintenance": { "type": "string", "format": "date" },
        "nextMaintenance": { "type": "string", "format": "date" }
      },
      "required": ["licensePlate", "type", "capacity"]
    },
    "Driver": {
      "title": "Condutor Sanitário",
      "description": "Motorista habilitado para transporte de saúde.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "phone": { "type": "string" },
        "available": { "type": "boolean" },
        "status": { "type": "string", "enum": ["AVAILABLE", "ON_ROUTE", "OFF_DUTY"] }
      },
      "required": ["name", "licenseNumber"]
    },
    "AuditLog": {
      "title": "Log de Auditoria",
      "description": "Registro de ação administrativa no sistema.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "ip": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "OfficialDocument": {
      "title": "Documento Oficial",
      "description": "Guia de diária ou combustível gerada pelo sistema.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["DIÁRIA", "COMBUSTÍVEL"] },
        "name": { "type": "string" },
        "driverName": { "type": "string" },
        "value": { "type": "string" },
        "status": { "type": "string", "enum": ["READY", "PRINTED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "name", "driverName", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Perfis de acesso administrativo."
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Base municipal de cidadãos."
    },
    "/requests/{requestId}": {
      "schema": "TransportRequest",
      "description": "Agendamentos de transporte."
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Cadastro da frota municipal."
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Corpo de condutores."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Logs de segurança."
    },
    "/official_documents/{docId}": {
      "schema": "OfficialDocument",
      "description": "Guias e requisições oficiais."
    }
  }
}
